{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "$code.matches(/^[A-Z]{4}$/)"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "games": {
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'google.com'",
          "$gid": {
            ".validate": "$gid.matches(/^[A-Za-z0-9_-]{4,24}$/) && newData.hasChildren(['t', 'w', 'n'])",
            "$field": {
              ".validate": "newData.isNumber() || newData.isString()"
            }
          }
        }
      }
    },
    "feedback": {
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['t', 'ty', 'm'])",
        "t": {
          ".validate": "newData.isNumber()"
        },
        "ty": {
          ".validate": "newData.val() === 'bug' || newData.val() === 'idea'"
        },
        "m": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 1500"
        },
        "n": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "c": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "ua": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "scr": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "g": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "u": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "leaderboard": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'google.com'",
        ".validate": "newData.hasChildren(['n', 'g', 'w', 't'])",
        "n": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
        },
        "g": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "w": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "k": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "l": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "p": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "x": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "bs": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "bk": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "og": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "ow": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "tg": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "tw": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
